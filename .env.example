APP_NAME=Bookly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-booking.dev4rweb.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u258706838_demo_booking
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Hostinger SMTP. QUEUE_CONNECTION=sync sends mail immediately (no worker).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@dev4rweb.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@dev4rweb.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Stripe TEST keys. Leave empty to run in demo mode (local plan switching, no charges).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Single platform Telegram bot. Leave empty to hide Connect Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# After deploy: php artisan telegram:set-webhook
# Webhook: https://demo-booking.dev4rweb.com/telegram/webhook
# Header check: X-Telegram-Bot-Api-Secret-Token = TELEGRAM_WEBHOOK_SECRET
